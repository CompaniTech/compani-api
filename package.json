    "@hapi/hapi": "~21.4.10",
    "@hapi/inert": "~7.1.2",
    "@notionhq/client": "~5.27.0",
    "@sentry/node": "~11.4.0",
    "@sentry/profiling-node": "~11.4.0",
    "axios": "~1.20.0",
    "bcryptjs": "~3.0.3",
    "bignumber.js": "~11.1.5",
    "cron": "~4.4.0",
